:host { display: block; }
.cloud-home, .cloud-services, .stored-copy, .mini-vip, .cloud-categories, .cloud-button { box-sizing: border-box; }
.cloud-button { margin: 0; padding: 0; font-size: 28rpx; font-weight: normal; line-height: 1.5; color: #60371F; transition: transform 140ms ease-out; }
.cloud-button::after { border: 0; }
.cloud-art { display: block; width: 100%; height: 360rpx; margin-top: 14rpx; }
.cloud-wordmark { font: bold italic 65rpx/1.2 Georgia, serif; text-align: center; color: #60371F; margin-top: -4rpx; letter-spacing: -3rpx; }
.cloud-tagline { text-align: center; color: #88684F; font-size: 21rpx; letter-spacing: 4rpx; margin: 15rpx 0 35rpx; }
.cloud-services { display: flex; gap: 15rpx; }
.cloud-service { flex: 1; padding: 21rpx 4rpx 16rpx; background: #FFFCF6; border: 1rpx solid #E7D8C4; border-radius: 16rpx; }
.cloud-service-icon { width: 93rpx; height: 93rpx; margin: 0 auto 15rpx; display: block; }
.cloud-service-title { font-size: 27rpx; font-weight: 600; font-family: "Songti SC", SimSun, serif; letter-spacing: 2rpx; }
.cloud-service-subtitle { font: 15rpx/1.5 Georgia, serif; letter-spacing: 2rpx; }
.cloud-member { width: 100%; background: #FFFCF6; border: 1rpx solid #E7D8C4; border-radius: 18rpx; padding: 20rpx 22rpx; margin-top: 20rpx; display: flex; justify-content: space-between; align-items: center; text-align: left; }
.stored-label { display: block; font-size: 19rpx; font-weight: 500; letter-spacing: 2rpx; line-height: 1.4; }
.stored-link { font: 29rpx/1.4 "Songti SC", SimSun, serif; margin-top: 24rpx; font-weight: bold; letter-spacing: 3rpx; }
.stored-arrow { margin-left: 20rpx; }
.mini-vip { width: 280rpx; height: 160rpx; background: #E9DABD; border-radius: 12rpx; padding: 12rpx 16rpx; position: relative; overflow: hidden; }
.vip-label { font: 31rpx Georgia, serif; position: absolute; top: 13rpx; left: 20rpx; }
.vip-art { width: 190rpx; height: 135rpx; display: block; margin-left: 67rpx; margin-top: 12rpx; }
.cloud-categories { display: flex; gap: 18rpx; margin-top: 20rpx; }
.cloud-category { flex: 1; display: flex; align-items: center; gap: 10rpx; background: #FFFCF6; border: 1rpx solid #E7D8C4; border-radius: 16rpx; padding: 23rpx 15rpx; }
.cloud-category-icon { width: 73rpx; height: 73rpx; }
.cloud-category-title { font-size: 26rpx; font-weight: 500; text-align: left; }
.cloud-category-subtitle { font: 18rpx Georgia, serif; display: block; margin-top: 6rpx; letter-spacing: 2rpx; }
.cloud-post { width: 100%; margin-top: 25rpx; text-align: left; display: flex; justify-content: space-between; font-size: 21rpx; color: #88684F; padding: 12rpx 2rpx; }
.cloud-post-link { color: #60371F; }
.pressed { transform: scale(.975); opacity: .86; }
@media (prefers-reduced-motion: reduce) { .cloud-button { transition: none; } .pressed { transform: none; } }
