<view class="sheet-mask" bindtap="close" catchtouchmove="noop"><view class="sheet" catchtap="noop"><view class="sheet-head"><view><view class="subtitle">你的小小满足</view><text class="eyebrow">YOUR BAG · {{count}} 件</text></view><view class="row"><button class="sheet-button muted small" bindtap="clear">清空</button><button class="sheet-button close-button" bindtap="close" aria-label="关闭购物车"><image class="sheet-image close-icon" src="/assets/icons/close.png" /></button></view></view>
<scroll-view scroll-y class="sheet-scroll"><view wx:for="{{items}}" wx:key="id" class="cart-item"><image class="sheet-image cart-product-image" src="{{item.image}}" mode="aspectFit"/><view class="cart-copy"><view class="cart-product-title">{{item.name}}</view><text class="small muted cart-product-specs">{{item.specText || '标准份'}}</text><view class="cart-item-bottom"><text class="cart-price">¥{{item.priceText}}</text><view class="cart-stepper"><button class="sheet-button cart-stepper-button" data-id="{{item.id}}" data-delta="-1" bindtap="change" aria-label="减少或删除商品">−</button><text class="cart-stepper-value">{{item.quantity}}</text><button class="sheet-button cart-stepper-button" data-id="{{item.id}}" data-delta="1" bindtap="change" aria-label="增加商品">+</button></view></view></view></view><view wx:if="{{!items.length}}" class="empty"><image class="sheet-image empty-image" src="/assets/illustrations/empty-cart.png" mode="aspectFit"/><view>小袋子还空着</view><text class="muted small">去挑一份今天的甜吧</text></view></scroll-view>
<view class="between cart-sheet-bottom"><view><text class="muted small">合计 </text><text class="price">¥{{total}}</text></view><button class="sheet-button btn cart-checkout {{!count ? 'is-disabled' : ''}}" disabled="{{!count}}" bindtap="checkout" hover-class="pressed">去结算 →</button></view></view></view>
