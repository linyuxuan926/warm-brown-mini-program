<view class="dog-home">
  <view class="dog-brand"><image class="dog-brand-art" src="/assets/illustrations/dog-hero.png" mode="aspectFit" aria-label="原创咖啡小狗伙伴线稿"/><view class="dog-wordmark">warm woof.</view><text class="dog-brand-tagline">COFFEE · BAKES · LITTLE PAWS</text></view>
  <view class="dog-welcome"><view class="dog-greeting"><view><view class="greeting-title">{{loggedIn ? '午后好，' + nickname : '欢迎来到暖棕咖啡'}}</view><text class="greeting-note">{{loggedIn ? '你的温暖日常，从这一杯开始' : '演示登录，解锁小屋惊喜权益'}}</text></view><button class="dog-button greeting-button" wx:if="{{!loggedIn}}" bindtap="login" hover-class="pressed">登录</button><button class="dog-button greeting-button" wx:else data-page="member" bindtap="open" hover-class="pressed">会员</button></view>
    <view class="dog-services"><button class="dog-button dog-service" data-mode="delivery" bindtap="order" hover-class="pressed"><image class="dog-service-icon" src="/assets/icons/dog-delivery.png" mode="aspectFit"/><view class="dog-service-title">外送到家</view><text class="dog-service-subtitle">DELIVERY</text></button><button class="dog-button dog-service" data-mode="dineIn" bindtap="order" hover-class="pressed"><image class="dog-service-icon" src="/assets/icons/dog-dineIn.png" mode="aspectFit"/><view class="dog-service-title">在店堂食</view><text class="dog-service-subtitle">DINE IN</text></button><button class="dog-button dog-service" data-mode="pickup" bindtap="order" hover-class="pressed"><image class="dog-service-icon" src="/assets/icons/dog-pickup.png" mode="aspectFit"/><view class="dog-service-title">到店自取</view><text class="dog-service-subtitle">PICK UP</text></button></view>
  </view>
  <button class="dog-button dog-store" data-page="store" bindtap="open" hover-class="pressed"><view class="dog-store-hours"><view class="open-dot"></view><text>小屋营业时间 09:00—20:00</text></view><text>门店详情 →</text></button>
  <view class="dog-benefits"><button class="dog-button dog-benefit" data-page="points" bindtap="open" hover-class="pressed"><view><text class="benefit-eyebrow">POINTS</text><view class="benefit-title">积分小铺</view><text class="benefit-note">把喜欢，攒成惊喜</text></view><image class="benefit-icon" src="/assets/icons/points.png" mode="aspectFit" /></button><button class="dog-button dog-benefit" data-page="coupons" bindtap="open" hover-class="pressed"><view><text class="benefit-eyebrow">COUPONS</text><view class="benefit-title">领券中心</view><text class="benefit-note">给日常一点小甜头</text></view><image class="benefit-icon" src="/assets/icons/coupon.png" mode="aspectFit" /></button></view>
  <button class="dog-button dog-mail" data-mode="shipping" bindtap="order" hover-class="pressed"><image class="dog-mail-icon" src="/assets/icons/shipping.png" mode="aspectFit"/><view class="dog-mail-copy">远方也能收到小屋的温暖<text class="dog-mail-note">常温烘焙 · 全国邮寄</text></view><text>→</text></button>
</view>
