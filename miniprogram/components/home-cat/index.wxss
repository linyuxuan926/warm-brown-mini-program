:host { display: block; }
.cat-home, .cat-welcome, .brand-seal, .cat-services, .service-line, .cat-button { box-sizing: border-box; }
.cat-button { margin: 0; padding: 0; font-size: 28rpx; font-weight: normal; line-height: 1.5; transition: transform 140ms ease-out; }
.cat-welcome { display: flex; justify-content: center; align-items: center; height: 128rpx; margin-top: 8rpx; padding-bottom: 10rpx; }
.cat-letter { font-family: Georgia, "Arial Rounded MT Bold", serif; font-size: 83rpx; font-weight: 900; color: #60371F; line-height: 1; letter-spacing: 2rpx; }
.brand-seal { width: 146rpx; border: 1.5rpx solid #97745A; border-radius: 50%; text-align: center; font: 18rpx/34rpx Georgia, serif; letter-spacing: 1rpx; color: #775137; margin: 7rpx auto -8rpx; transform: rotate(-4deg); }
.cat-art { display: block; width: 100%; height: 428rpx; }
.cat-caption { text-align: center; font-size: 22rpx; letter-spacing: 3rpx; color: #88684F; margin-top: -7rpx; }
.caption-dot { margin: 0 14rpx; }
.cat-services { display: flex; align-items: center; justify-content: space-evenly; margin: 25rpx 12rpx 30rpx; }
.cat-service { width: 44%; padding: 10rpx 0; background: transparent; color: #60371F; line-height: 1.5; }
.cat-button::after { border: 0; }
.cat-service-icon { display: block; width: 100rpx; height: 100rpx; margin: 0 auto 9rpx; }
.cat-service-title { font-size: 32rpx; font-weight: 600; font-family: "Songti SC", SimSun, serif; letter-spacing: 7rpx; }
.cat-service-subtitle { font: italic 17rpx/1.6 Georgia, serif; letter-spacing: 4rpx; }
.service-line { width: 1rpx; height: 143rpx; background: #CBB698; }
.cat-member { display: flex; align-items: center; justify-content: space-between; width: 100%; background: #60371F; border: 1rpx solid #60371F; border-radius: 32rpx 32rpx 32rpx 3rpx; padding: 27rpx 34rpx; color: #FFF7E8; text-align: left; }
.member-title { font-size: 32rpx; font-family: "Songti SC", SimSun, serif; letter-spacing: 7rpx; }
.member-english { font-family: Georgia, serif; font-style: italic; font-size: 29rpx; letter-spacing: 2rpx; line-height: 1.25; margin-top: 3rpx; }
.member-note { font-size: 19rpx; margin-top: 12rpx; letter-spacing: 1rpx; }
.member-arrow { margin-left: 14rpx; }
.member-crown { width: 146rpx; height: 123rpx; margin-right: 10rpx; }
.pressed { transform: scale(.975); opacity: .86; }
@media (prefers-reduced-motion: reduce) { .cat-button { transition: none; } .pressed { transform: none; } }
