<view class="sheet-mask" bindtap="close" catchtouchmove="noop"><view class="sheet" catchtap="noop">
  <view class="sheet-head"><text class="eyebrow">MAKE IT YOURS</text><button class="sheet-button close-button" bindtap="close" aria-label="关闭商品规格"><image class="sheet-image close-icon" src="/assets/icons/close.png" /></button></view>
  <scroll-view scroll-y class="sheet-scroll"><view class="spec-intro"><image class="sheet-image spec-product-image" src="{{product.image}}" mode="aspectFit" /><view class="spec-product-copy"><view class="subtitle">{{product.name}}</view><view class="small muted spec-description">{{product.description}}</view><text class="badge spec-badge">今日手作 · 新鲜出炉</text></view></view>
    <view wx:for="{{product.specGroups}}" wx:key="id" wx:for-item="group" class="spec-group"><view class="label">{{group.name}} <text wx:if="{{group.required}}">· 必选</text></view><view class="spec-options"><button wx:for="{{group.options}}" wx:for-item="option" wx:key="id" data-group="{{group.id}}" data-option="{{option.id}}" class="sheet-button spec-option {{selected[group.id] === option.id ? 'chosen' : ''}}" bindtap="select" hover-class="pressed">{{option.name}}<text class="spec-option-extra" wx:if="{{option.extra}}"> +¥{{option.extra / 100}}</text></button></view></view>
    <view class="between spec-quantity"><text>数量</text><view class="stepper"><button class="sheet-button stepper-button {{quantity === 1 ? 'is-disabled' : ''}}" data-delta="-1" bindtap="quantity" disabled="{{quantity === 1}}" aria-label="减少数量">−</button><text class="stepper-value">{{quantity}}</text><button class="sheet-button stepper-button {{quantity >= product.stock || quantity >= 99 ? 'is-disabled' : ''}}" data-delta="1" bindtap="quantity" disabled="{{quantity >= product.stock || quantity >= 99}}" aria-label="增加数量">+</button></view></view>
  </scroll-view>
  <view class="between spec-footer"><view><text class="small muted">小计 </text><text class="price">¥{{subtotal}}</text></view><button class="sheet-button btn {{!complete ? 'is-disabled' : ''}}" bindtap="add" disabled="{{!complete}}" hover-class="pressed">{{complete ? '加入购物车' : '请选择必选规格'}}</button></view>
</view></view>
