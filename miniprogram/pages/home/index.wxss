.home-page { padding: 8rpx 34rpx 24rpx; }
.home-top { display: flex; justify-content: space-between; align-items: center; color: #88684F; font-size: 21rpx; letter-spacing: 2rpx; padding: 2rpx 8rpx; }
.style-switch { padding: 16rpx 0 16rpx 24rpx; font-size: 21rpx; color: #88684F; letter-spacing: 0; }
.style-switch text { margin-left: 5rpx; }
.home-foot { margin-top: 32rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; color: #88684F; font-size: 15rpx; letter-spacing: 2rpx; }
.home-foot view { width: 22rpx; height: 1rpx; background: #CDB698; }
