.about-page{padding-bottom:45rpx}.about-brand{display:flex;flex-direction:column;align-items:center;text-align:center;gap:17rpx;padding:0 0 42rpx;border-bottom:1rpx solid #CDB496}.about-brand image{width:380rpx;height:300rpx}.about-brand .eyebrow{font-size:18rpx;letter-spacing:3rpx}.brand-title{font-size:56rpx;letter-spacing:8rpx;margin-top:4rpx}.brand-en{font-size:39rpx;font-style:italic}.about-brand>.small{font-size:23rpx;letter-spacing:2rpx;margin-top:8rpx}.about-story{padding-top:18rpx}.story-row{display:flex;gap:26rpx;padding:30rpx 0;border-bottom:1rpx solid #E7D8C4}.story-number{font-size:37rpx;line-height:1.3;color:#88684F;font-style:italic}.story-row>view{flex:1;display:flex;flex-direction:column;gap:16rpx}.story-title{font-size:32rpx;line-height:1.5}.story-text{font-size:26rpx;color:#88684F;line-height:1.95}.about-links{display:flex;flex-direction:column;gap:18rpx;padding-top:35rpx}.about-links button{width:100%}.about-footer{display:flex;flex-direction:column;align-items:center;text-align:center;gap:13rpx;padding-top:38rpx;font-size:20rpx;color:#88684F}.about-footer .serif{font-size:30rpx;font-style:italic;margin-bottom:10rpx}
.about-page{padding-bottom:calc(45rpx + env(safe-area-inset-bottom))}
