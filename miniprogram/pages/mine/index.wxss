.mine-page{padding-top:30rpx;padding-bottom:36rpx}.profile{display:flex;gap:22rpx;align-items:center;flex-wrap:wrap}.avatar{width:110rpx;height:110rpx;border:1rpx solid #CDB496;background:#F5EAD7;border-radius:50%;display:flex;align-items:center;justify-content:center}.avatar image{width:62rpx;height:68rpx}.profile-copy{flex:1;display:flex;flex-direction:column;gap:11rpx;min-width:330rpx}.profile-copy .eyebrow{font-size:17rpx;letter-spacing:2rpx}.nickname{font-size:36rpx}.login{margin:0 0 0 auto}.account-strip{display:flex;padding:38rpx 0 34rpx;margin-top:12rpx}.account-strip>view{flex:1;display:flex;flex-direction:column;gap:12rpx;text-align:center;border-right:1rpx solid #E7D8C4}.account-strip>view:last-child{border:0}.account-number{font-size:38rpx;line-height:1.2;font-family:Georgia,serif}.member-banner{background:#60371F;color:#FFF7E8;border-radius:22rpx;padding:30rpx;display:flex;justify-content:space-between;align-items:center}.member-banner>view{display:flex;flex-direction:column;gap:15rpx}.member-banner .eyebrow{font-size:17rpx;color:#E7D8C4}.member-banner .serif{font-size:33rpx}.member-banner image{width:100rpx;height:106rpx;flex-shrink:0;margin-left:10rpx}.orders-section{padding:36rpx 4rpx 26rpx}.section-title{font-size:32rpx}.shortcut-grid{display:flex;margin-top:28rpx;justify-content:space-between}.shortcut{display:flex;flex-direction:column;align-items:center;gap:14rpx;min-width:125rpx;font-size:24rpx;padding:6rpx 0}.shortcut image{width:48rpx;height:48rpx}.entry-list{border-top:1rpx solid #E7D8C4}.entry{display:flex;align-items:center;gap:22rpx;padding:25rpx 4rpx;border-bottom:1rpx solid #E7D8C4}.entry-icon{width:43rpx;height:43rpx;flex-shrink:0}.entry-text{flex:1;display:flex;flex-direction:column;gap:8rpx;font-size:28rpx}.entry-en{font-size:16rpx;letter-spacing:2rpx;color:#88684F}.entry-arrow{width:26rpx;height:26rpx;margin-left:6rpx}.account-actions{display:flex;justify-content:center;gap:16rpx;padding:28rpx 0 8rpx}.account-actions button{font-size:23rpx;line-height:2.4;color:#88684F;background:transparent;padding:6rpx 18rpx;margin:0}.account-actions button::after{border:0}.demo-note{display:block;text-align:center;font-size:20rpx;padding-top:12rpx}
