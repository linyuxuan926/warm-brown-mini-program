<view class="page mine-page">
  <view class="profile"><view class="avatar"><image src="/assets/icons/user.png" mode="aspectFit"/></view><view class="profile-copy"><text class="eyebrow">HELLO, SWEET FRIEND</text><text class="serif nickname">{{member.loggedIn ? member.nickname : '欢迎来暖棕小屋'}}</text><text class="small muted">{{member.loggedIn ? member.level : '登录演示账户，收好每一份小确幸'}}</text></view><button wx:if="{{!member.loggedIn}}" class="btn btn-small login" bindtap="login">演示登录</button></view>
  <view class="account-strip"><view data-route="wallet" bindtap="open"><text class="account-number">{{balanceText}}</text><text class="small muted">储值余额 / 元</text></view><view data-route="points" bindtap="open"><text class="account-number">{{member.points || 0}}</text><text class="small muted">暖棕积分</text></view><view data-route="coupons" bindtap="open"><text class="account-number">{{couponCount}}</text><text class="small muted">可用优惠券</text></view></view>
  <view class="member-banner" data-route="member" bindtap="open"><view><text class="eyebrow">A LITTLE MORE FOR MEMBERS</text><text class="serif">把日常，过得甜一点。</text><text class="small">查看会员权益与成长记录 →</text></view><image src="/assets/icons/crown-cream.png" mode="aspectFit"/></view>
  <view class="orders-section"><view class="row between"><text class="serif section-title">我的订单</text><text class="small muted" data-filter="all" bindtap="orders">全部记录 →</text></view><view class="shortcut-grid"><view wx:for="{{shortcuts}}" wx:key="id" class="shortcut" data-filter="{{item.id}}" bindtap="orders"><image src="/assets/icons/{{item.icon}}.png" mode="aspectFit"/><text>{{item.name}}</text></view></view></view>
  <view class="entry-list"><view wx:for="{{entries}}" wx:key="route" class="entry" data-route="{{item.route}}" bindtap="open"><image class="entry-icon" src="/assets/icons/{{item.icon}}.png" mode="aspectFit"/><view class="entry-text"><text>{{item.name}}</text><text class="entry-en">{{item.en}}</text></view><text wx:if="{{item.route === 'themes'}}" class="small muted">{{themeName}}</text><image class="entry-arrow" src="/assets/icons/arrow.png" mode="aspectFit"/></view></view>
  <view class="account-actions"><button wx:if="{{member.loggedIn}}" bindtap="logout">退出演示账户</button><button bindtap="reset" disabled="{{busy}}">重置演示数据</button></view><text class="small muted demo-note">本地演示账户 · 无真实身份认证与资金交易</text>
</view>
