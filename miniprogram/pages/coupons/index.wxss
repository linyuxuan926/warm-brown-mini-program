.coupon-page{padding-bottom:44rpx}.coupon-heading{display:flex;flex-direction:column;gap:18rpx;padding:22rpx 0 32rpx}.coupon-heading .title{font-size:40rpx}.coupon-tabs{display:flex;border-bottom:1rpx solid #E7D8C4;margin-bottom:30rpx}.coupon-tabs button{background:transparent;border-radius:0;flex:1;font-size:28rpx;color:#88684F;padding:14rpx 4rpx 22rpx;margin:0}.coupon-tabs button::after{border:0}.coupon-tabs .active{color:#60371F;border-bottom:4rpx solid #60371F;font-weight:500}.selection-note{display:flex;flex-direction:column;gap:18rpx;margin-bottom:26rpx;line-height:1.8}.selection-note button{margin:0;width:100%}.login-note{padding:24rpx;border:1rpx dashed #CDB496;display:flex;gap:20rpx;align-items:center;margin-bottom:26rpx;border-radius:14rpx}.login-note text{flex:1;line-height:1.8}.login-note button{margin:0;flex-shrink:0}.coupon{display:flex;background:#FFFCF6;border:1rpx solid #E7D8C4;border-radius:18rpx;overflow:hidden;margin-bottom:24rpx}.coupon-selected{border:2rpx solid #60371F}.coupon-value{background:#F5EAD7;width:190rpx;flex-shrink:0;padding:30rpx 12rpx;text-align:center;display:flex;flex-direction:column;justify-content:center;gap:18rpx;box-sizing:border-box;border-right:1rpx dashed #CDB496}.coupon-value>text:first-child{font-size:66rpx;font-family:Georgia,serif}.currency{font-size:28rpx;margin-right:3rpx}.threshold{font-size:21rpx}.coupon-body{flex:1;min-width:0;padding:26rpx 22rpx;display:flex;flex-direction:column;gap:13rpx;line-height:1.6}.coupon-name{font-size:29rpx;font-weight:500}.coupon-body .small{font-size:21rpx}.expiry{font-size:20rpx;color:#88684F}.coupon-reason{font-size:22rpx;color:#60371F}.inactive{opacity:.63}.choose-label{font-size:22rpx;border-bottom:1rpx solid #60371F;flex-shrink:0;margin-left:12rpx}.claim-button{background:#60371F;color:#FFF7E8;font-size:23rpx;line-height:2.5;padding:0 18rpx;border-radius:10rpx;margin:5rpx 0 0;align-self:flex-start}.claim-button.claimed{background:#F5EAD7;color:#88684F}.claim-button::after{border:0}.empty-art{width:320rpx;height:270rpx}.empty-title{font-size:32rpx}.points-link{display:flex;align-items:center;gap:24rpx;padding:30rpx 10rpx;border-top:1rpx solid #E7D8C4}.points-link image{width:70rpx;height:70rpx}.points-link>view{display:flex;flex-direction:column;gap:12rpx;font-size:28rpx}.coupon-footer{display:block;padding:22rpx 8rpx 0;color:#88684F;font-size:21rpx;line-height:1.9;text-align:center}
.coupon-page{padding-bottom:calc(44rpx + env(safe-area-inset-bottom))}
