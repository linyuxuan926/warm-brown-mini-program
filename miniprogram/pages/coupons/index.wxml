<view class="page coupon-page">
  <view class="coupon-heading"><text class="eyebrow">A SWEET LITTLE TREAT</text><text class="serif title">把小优惠，装进口袋。</text><text class="muted small">每份订单最多使用一张，按商品金额计算门槛。</text></view>
  <view class="coupon-tabs"><button class="{{tab === 'owned' ? 'active' : ''}}" data-id="owned" bindtap="chooseTab">我的优惠券</button><button class="{{tab === 'offers' ? 'active' : ''}}" data-id="offers" bindtap="chooseTab">今日可领取</button></view>
  <view wx:if="{{selectMode}}" class="selection-note"><text class="small muted">正在为当前购物车选券；不可用原因显示在券面。</text><button class="btn-outline btn-small" bindtap="noCoupon">本单不使用优惠券</button></view>
  <view wx:if="{{!member.loggedIn}}" class="login-note"><text class="small muted">演示登录后，即可领取属于你的甜蜜心意。</text><button class="btn btn-small" bindtap="login">演示登录</button></view>
  <block wx:if="{{tab === 'owned'}}"><view wx:if="{{!coupons.length}}" class="empty"><image class="empty-art" src="/assets/illustrations/empty-coupon.png" mode="aspectFit"/><text class="serif empty-title">口袋里还没有优惠券</text><text class="muted small">切换到「今日可领取」，收下一份小礼物。</text></view><view wx:for="{{coupons}}" wx:key="id" class="coupon {{item.status !== 'available' ? 'inactive' : ''}} {{selectedId === item.id ? 'coupon-selected' : ''}}" data-id="{{item.id}}" bindtap="select"><view class="coupon-value"><text><text class="currency">¥</text>{{item.discountText}}</text><text class="threshold">满 {{item.thresholdText}} 元可用</text></view><view class="coupon-body"><view class="row between"><text class="coupon-name">{{item.name}}</text><text wx:if="{{selectMode && item.eligible}}" class="choose-label">{{selectedId === item.id ? '已选' : '选择'}}</text></view><text class="small muted">{{item.scopeLabel}} · {{item.modeLabel}}</text><text class="expiry">有效期至 {{item.expiresText}}</text><text class="coupon-reason">{{item.reason || item.statusText}}</text></view></view></block>
  <block wx:else><view wx:if="{{!offers.length}}" class="empty"><text class="muted">今天的心意已领完，去积分小铺看看吧。</text></view><view wx:for="{{offers}}" wx:key="id" class="coupon offer"><view class="coupon-value"><text><text class="currency">¥</text>{{item.discountText}}</text><text class="threshold">满 {{item.thresholdText}} 元可用</text></view><view class="coupon-body"><text class="coupon-name">{{item.name}}</text><text class="small muted">{{item.scopeLabel}} · {{item.modeLabel}}</text><text class="expiry">领取后 {{item.days}} 天内有效 · 每位会员限领一次</text><button class="claim-button {{item.claimed ? 'claimed' : ''}}" data-id="{{item.id}}" bindtap="claim" disabled="{{busy || item.claimed || !member.loggedIn}}">{{item.claimed ? '已经领取' : '收下这份心意'}}</button></view></view><view class="points-link" bindtap="points"><image src="/assets/icons/points.png" mode="aspectFit"/><view><text>积分也能换一份甜</text><text class="small muted">去积分小铺兑换更多优惠 →</text></view></view></block>
  <text class="coupon-footer">待支付订单将占用所选券；取消订单后释放，支付成功后核销。</text>
</view>
