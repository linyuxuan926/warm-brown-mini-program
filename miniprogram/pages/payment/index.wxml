<view class="page payment-page" wx:if="{{order}}">
  <view class="payment-stamp">DEMO PAYMENT</view><view class="payment-heading serif">只是一场甜蜜演练</view><view class="payment-description">课程演示 · 模拟支付</view><view class="payment-amount">¥<text>{{totalText}}</text></view><view class="payment-order">{{modeName}} · {{order.number}}</view>
  <view class="notice section">本页仅演示支付结果，不调用微信支付，不会收取真实费用。演示余额也仅为本地模拟数据。</view>
  <block wx:if="{{order.status === 'pending'}}"><view class="payment-methods"><button class="payment-method {{method === 'mock' ? 'chosen' : ''}}" data-method="mock" bindtap="method" hover-class="pressed"><view class="row"><image class="icon" src="/assets/icons/coupon.png" mode="aspectFit"/><view><view>模拟支付</view><text class="small muted">选择成功、取消或失败结果</text></view></view><view class="radio-mark"><view wx:if="{{method === 'mock'}}"></view></view></button><button class="payment-method {{method === 'balance' ? 'chosen' : ''}}" data-method="balance" bindtap="method" hover-class="pressed"><view class="row"><image class="icon" src="/assets/icons/wallet.png" mode="aspectFit"/><view><view>演示余额</view><text class="small muted">可用 ¥{{balanceText}}{{member.loggedIn ? '' : ' · 请先演示登录'}}</text></view></view><view class="radio-mark"><view wx:if="{{method === 'balance'}}"></view></view></button></view>
  <view class="balance-tools" wx:if="{{method === 'balance'}}"><button class="link small" wx:if="{{!member.loggedIn}}" bindtap="login">登录演示账户</button><button class="link small" bindtap="wallet">前往模拟储值 →</button></view>
  <view wx:if="{{error}}" class="notice section">{{error}}</view><button class="btn payment-primary" data-outcome="success" bindtap="result" disabled="{{busy}}" loading="{{busy}}" hover-class="pressed">{{method === 'balance' ? '使用演示余额支付' : '模拟支付成功'}}</button><view class="payment-outcomes"><button class="btn-outline" data-outcome="cancel" bindtap="result" disabled="{{busy}}" hover-class="pressed">取消本次支付</button><button class="btn-outline" data-outcome="failure" bindtap="result" disabled="{{busy}}" hover-class="pressed">模拟支付失败</button></view></block>
  <button wx:else class="btn" bindtap="order">订单状态已更新 · 查看订单</button>
  <view class="footer-note">温暖会等你，订单也是。</view>
</view><view class="page empty" wx:else><image src="/assets/illustrations/empty-order.png" mode="aspectFit"/><text>{{error || '正在准备订单…'}}</text></view>
