.address-page{padding-bottom:45rpx}.address-heading{padding:22rpx 0 28rpx;display:flex;flex-direction:column;gap:18rpx}.address-heading .title{font-size:40rpx}.address-notice{margin-bottom:28rpx;font-size:23rpx}.address-card{background:#FFFCF6;border:1rpx solid #E7D8C4;border-radius:20rpx;margin-bottom:24rpx;overflow:hidden}.address-selected{border-color:#60371F}.address-main{padding:28rpx;display:flex;flex-direction:column;gap:15rpx}.contact-line{display:flex;gap:18rpx;align-items:center;flex-wrap:wrap}.contact-name{font-size:31rpx;font-weight:500}.phone{font-size:25rpx;color:#88684F}.address-region{font-size:24rpx;color:#88684F;margin-top:4rpx}.address-detail{font-size:28rpx;line-height:1.8;word-break:break-all}.service-zone{font-size:20rpx;color:#88684F;line-height:1.7}.choose-address{font-size:22rpx;color:#60371F;flex-shrink:0}.address-tools{display:flex;justify-content:space-between;border-top:1rpx solid #E7D8C4;padding:14rpx 22rpx;align-items:center}.address-tools>view{display:flex;gap:12rpx}.address-tools button{margin:0;padding:8rpx 12rpx;font-size:23rpx;color:#88684F;line-height:1.8}.default-button{display:flex;align-items:center;gap:12rpx}.radio-circle{width:27rpx;height:27rpx;border:1rpx solid #BCA48A;border-radius:50%;display:flex;justify-content:center;align-items:center}.radio-circle>view{width:15rpx;height:15rpx;background:#60371F;border-radius:50%}.address-tools .is-default{color:#60371F}.add-button{width:100%;display:flex;gap:16rpx;margin-top:30rpx}.add-button image{width:28rpx;height:28rpx;filter:brightness(0) invert(.96)}.address-footnote{display:block;font-size:21rpx;color:#88684F;text-align:center;line-height:1.9;margin-top:25rpx}.empty-address{width:110rpx!important;height:130rpx!important}.sheet-title{font-size:34rpx;display:block;margin-top:12rpx}.address-form{max-height:62vh}.address-form .field{margin:15rpx 0 18rpx}.form-pair{display:flex;gap:18rpx}.form-pair>view{flex:1;min-width:0}.address-form .input{background:#FAF3E3;font-size:26rpx}.detail-input{height:140rpx;line-height:1.7}.default-switch{display:flex;align-items:center;justify-content:space-between;padding:20rpx 0}.default-switch>view{display:flex;flex-direction:column;gap:10rpx;font-size:27rpx}.field-hint{padding:12rpx 0 25rpx;line-height:1.8;font-size:21rpx}.save-address{width:100%;margin-top:20rpx}
.add-symbol{font-size:37rpx;line-height:1;color:#FFF7E8;font-weight:300}.address-page{padding-bottom:calc(45rpx + env(safe-area-inset-bottom))}
.address-form{height:54vh;max-height:850rpx}
