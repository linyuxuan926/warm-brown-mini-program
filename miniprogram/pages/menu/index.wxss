.menu-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.menu-top { padding: 20rpx 30rpx 22rpx; background: #FAF3E3; }
.store-name { text-align: left; }
.store-title { font-size: 31rpx; font-weight: 600; }
.store-title text { margin-left: 10rpx; font-weight: 400; }
.store-hours { display: flex; align-items: center; gap: 9rpx; font-size: 21rpx; color: #88684F; margin-top: 5rpx; }
.open-dot { width: 8rpx; height: 8rpx; background: #97745A; border-radius: 50%; }
.mode-button { border: 1rpx solid #BCA48A; border-radius: 100rpx; padding: 13rpx 20rpx; font-size: 24rpx; color: #60371F; }
.mode-button text { margin-left: 10rpx; }
.fulfillment-detail { display: flex; justify-content: space-between; width: 100%; padding: 20rpx 0 14rpx; font-size: 22rpx; color: #88684F; text-align: left; }
.fulfillment-detail text:first-child { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 80%; }
.search-box { display: flex; align-items: center; padding: 0 22rpx; height: 74rpx; border: 1rpx solid #E1CFB8; border-radius: 13rpx; background: #F5EAD7; gap: 16rpx; }
.search-box image { width: 33rpx; height: 33rpx; opacity: .7; }
.search-box input { flex: 1; font-size: 24rpx; min-width: 0; }
.search-box button { min-width: 50rpx; font-size: 36rpx; }
.search-note { font-size: 16rpx; letter-spacing: 2rpx; color: #88684F; }
.shipping-note { font-size: 20rpx; padding: 11rpx 24rpx; background: #EDE0C9; text-align: center; color: #775137; }
.menu-body { display: flex; flex: 1; min-height: 0; background: #FFFCF6; overflow: hidden; }
.category-nav { flex-shrink: 0; width: 158rpx; background: #F1E7D6; height: 100%; }
.category { width: 100%; min-height: 116rpx; position: relative; padding: 32rpx 12rpx; font-size: 24rpx; color: #88684F; text-align: center; }
.category.active { background: #FFFCF6; color: #60371F; font-weight: 600; }
.category-marker { display: none; width: 5rpx; height: 34rpx; border-radius: 3rpx; position: absolute; left: 0; top: 39rpx; background: #60371F; }
.active .category-marker { display: block; }
.nav-bottom { white-space: pre-line; text-align: center; margin: 55rpx 0; font: italic 18rpx/1.6 Georgia, serif; letter-spacing: 3rpx; color: #97745A; }
.product-scroll { flex: 1; width: 0; height: 100%; }
.list-heading { display: flex; justify-content: space-between; font-size: 24rpx; padding: 25rpx 25rpx 0; color: #88684F; }
.list-heading .eyebrow { font-size: 15rpx; letter-spacing: 2rpx; }
.product-item { display: flex; align-items: center; gap: 20rpx; margin: 0 22rpx; padding: 28rpx 0; border-bottom: 1rpx solid #EDE2D2; }
.product-image { width: 168rpx; height: 180rpx; background: #F5EAD7; border-radius: 17rpx; position: relative; overflow: hidden; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.product-image image { width: 100%; height: 100%; }
.product-image[disabled] { background: #EFE7DB; }
.product-image[disabled] image { opacity: .45; }
.sold-out { position: absolute; padding: 6rpx 16rpx; background: #88684F; border-radius: 40rpx; color: #FFF7E8; font-size: 20rpx; top: 70rpx; left: 27rpx; }
.product-copy { flex: 1; min-width: 0; }
.product-name { font-size: 27rpx; font-weight: 600; line-height: 1.4; }
.product-description { font-size: 22rpx; color: #88684F; margin-top: 7rpx; line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.product-tag { display: inline-block; font-size: 17rpx; color: #8A5F3B; border-bottom: 1rpx solid #CAB089; margin-top: 8rpx; }
.product-bottom { margin-top: 12rpx; }
.product-price { font: 31rpx Georgia, serif; color: #60371F; font-weight: 600; }
.from-price { font-size: 18rpx; color: #88684F; }
.add-product { width: 88rpx; height: 88rpx; line-height: 84rpx; border-radius: 50%; background: #60371F; color: #FFF7E8; font-size: 38rpx; position: relative; overflow: visible; }
.product-count { position: absolute; right: -6rpx; top: -12rpx; font-size: 17rpx; min-width: 26rpx; height: 26rpx; line-height: 26rpx; background: #C6A16B; border: 2rpx solid #FFFCF6; border-radius: 50%; }
.product-end { text-align: center; padding: 40rpx 0 50rpx; font-size: 22rpx; color: #88684F; }
.product-end text { display: block; font-size: 14rpx; letter-spacing: 2rpx; margin-top: 5rpx; }
.bag-bar { background: #FFFCF6; border-top: 1rpx solid #E7D8C4; padding: 17rpx 25rpx; display: flex; align-items: center; gap: 14rpx; flex-shrink: 0; }
.bag-summary { display: flex; align-items: center; text-align: left; gap: 20rpx; flex: 1; min-width: 0; }
.bag-icon { position: relative; }
.bag-icon image { width: 67rpx; height: 67rpx; }
.bag-icon > text { position: absolute; top: -7rpx; right: -8rpx; padding: 0 8rpx; border-radius: 30rpx; color: #FFF7E8; background: #60371F; font-size: 19rpx; min-width: 30rpx; text-align: center; }
.bag-total { font: 37rpx/1.2 Georgia, serif; font-weight: 600; color: #60371F; }
.bag-summary > view > text { font-size: 18rpx; color: #88684F; }
.bag-checkout { border-radius: 13rpx; background: #60371F; color: #FFF7E8; min-height: 82rpx; padding: 22rpx 30rpx; font-size: 26rpx; }
.bag-checkout > text { margin-left: 16rpx; }
.menu-empty { padding: 60rpx 25rpx; font-size: 25rpx; }
.menu-empty image { width: 180rpx; height: 155rpx; }
