<view class="menu-page">
  <view class="menu-top"><view class="between"><button class="store-name" bindtap="store" hover-class="pressed"><view class="store-title">{{store.name}} <text>›</text></view><view class="store-hours"><view class="open-dot"></view><text>演示营业 · {{store.hours}}</text></view></button><button class="mode-button" bindtap="switchMode" hover-class="pressed">{{modeName}} <text>⌄</text></button></view><button class="fulfillment-detail" bindtap="configure" hover-class="pressed"><text>{{detailText}}</text><text>修改 ›</text></button>
  <view class="search-box"><image src="/assets/icons/coffee.png" mode="aspectFit"/><input placeholder="寻找今天的小甜头" placeholder-style="color:#947B63" value="{{search}}" bindinput="search" confirm-type="search" maxlength="40"/><button wx:if="{{search}}" bindtap="clearSearch" aria-label="清除搜索">×</button><text wx:else class="search-note">SEARCH</text></view></view>
  <view wx:if="{{mode === 'shipping'}}" class="shipping-note">常温好物 · 满 ¥128 包邮 · 48 小时内演示发货</view>
  <view class="menu-body"><scroll-view class="category-nav" scroll-y><button wx:for="{{categories}}" wx:key="id" class="category {{categoryId === item.id && !search ? 'active' : ''}}" data-id="{{item.id}}" bindtap="category" hover-class="pressed"><view class="category-marker"></view><text>{{item.name}}</text></button><view class="nav-bottom"><view>SLOW</view><view>&amp; SWEET</view></view></scroll-view>
    <scroll-view class="product-scroll" scroll-y scroll-top="{{scrollTop}}"><view class="list-heading"><text>{{search ? '搜索结果' : '今日手作'}}</text><text class="eyebrow">FRESHLY MADE</text></view>
      <view wx:for="{{products}}" wx:key="id" class="product-item"><button class="product-image" data-id="{{item.id}}" bindtap="openProduct" hover-class="pressed" disabled="{{!item.stock}}"><image src="{{item.image}}" mode="aspectFit"/><text wx:if="{{!item.stock}}" class="sold-out">今日售罄</text></button><view class="product-copy"><view class="product-name">{{item.name}}</view><view class="product-description">{{item.description}}</view><text wx:if="{{item.tag}}" class="product-tag">{{item.tag}}</text><view class="between product-bottom"><view><text class="product-price">¥{{item.priceText}}</text><text wx:if="{{item.specGroups.length}}" class="from-price"> 起</text></view><button class="add-product" disabled="{{!item.stock}}" data-id="{{item.id}}" bindtap="openProduct" hover-class="pressed" aria-label="选择{{item.name}}规格"><text wx:if="{{item.quantity}}" class="product-count">{{item.quantity}}</text><text>+</text></button></view></view></view>
      <view class="empty menu-empty" wx:if="{{!products.length}}"><image src="/assets/illustrations/empty-cart.png" mode="aspectFit"/><view>{{search ? '没有找到这份小甜头' : '这个分类暂时没有适用商品'}}</view><text class="small muted">{{search ? '试试其他关键词，或看看今天的推荐' : '试试其他分类吧'}}</text><button wx:if="{{search}}" class="btn-outline btn-small" bindtap="clearSearch">清除搜索</button></view><view class="product-end">好食材，好心情。<text>MADE WITH A LITTLE LOVE</text></view>
    </scroll-view>
  </view>
  <view class="bag-bar"><button class="bag-summary" bindtap="toggleCart" hover-class="pressed"><view class="bag-icon"><image src="/assets/icons/bag.png" mode="aspectFit"/><text wx:if="{{cart.count}}">{{cart.count}}</text></view><view><view class="bag-total">¥{{cartTotal}}</view><text>{{cart.count ? '配送费及优惠在结算时计算' : '一份温暖，正在等你'}}</text></view></button><button class="bag-checkout" disabled="{{!cart.count}}" bindtap="checkout" hover-class="pressed">去结算 <text>→</text></button></view>
</view>
<spec-sheet wx:if="{{product}}" product="{{product}}" bind:close="closeProduct" bind:add="addProduct" />
<cart-sheet wx:if="{{cartVisible}}" items="{{cart.items}}" total="{{cartTotal}}" count="{{cart.count}}" bind:close="closeCart" bind:clear="clearCart" bind:change="changeCart" bind:checkout="checkout" />
