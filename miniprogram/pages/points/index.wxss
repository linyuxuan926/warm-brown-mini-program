.points-page{padding-bottom:42rpx}.points-heading{padding:22rpx 0 32rpx;display:flex;flex-direction:column;gap:18rpx}.points-heading .title{font-size:39rpx}.points-balance{padding:26rpx 4rpx 34rpx;display:flex;justify-content:space-between;align-items:center;border-bottom:1rpx solid #E7D8C4}.points-balance>view{display:flex;flex-direction:column;gap:18rpx}.points-balance image{width:120rpx;height:128rpx;margin-right:26rpx}.points-number{font-family:Georgia,serif;font-size:80rpx;line-height:1.3}.points-number text{font-family:initial;font-size:25rpx}.notice{margin-top:24rpx;line-height:1.9}.login-btn{margin-top:24rpx}.exchange-heading{display:flex;flex-direction:column;gap:16rpx;padding:34rpx 0 25rpx}.section-title{font-size:32rpx}.exchange-card{display:flex;border:1rpx solid #E7D8C4;border-radius:20rpx;overflow:hidden;background:#FFFCF6;margin-bottom:22rpx}.exchange-art{width:170rpx;flex-shrink:0;background:#F5EAD7;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:22rpx}.exchange-art image{width:78rpx;height:70rpx}.exchange-value{font-family:Georgia,serif;font-size:40rpx}.exchange-copy{padding:26rpx;flex:1;min-width:0;display:flex;flex-direction:column;gap:15rpx}.exchange-name{font-size:29rpx}.exchange-copy .small{font-size:21rpx;line-height:1.7}.exchange-copy button{margin:0;padding:0 24rpx}.points-cost{font-size:27rpx}.coupon-jump{display:flex;justify-content:space-between;font-size:25rpx;padding:23rpx 6rpx}.points-history{border-top:1rpx solid #E7D8C4;margin-top:22rpx;padding-top:30rpx}.points-history .section-title{display:block;margin:15rpx 0}.history-row{display:flex;justify-content:space-between;gap:20rpx;align-items:center;padding:25rpx 0;border-bottom:1rpx solid #E7D8C4;font-size:26rpx}.history-row>view{display:flex;flex-direction:column;gap:13rpx}.history-amount{text-align:right;flex-shrink:0}.history-amount>text:first-child{font-family:Georgia,serif;font-size:32rpx}
.points-page{padding-bottom:calc(42rpx + env(safe-area-inset-bottom))}
