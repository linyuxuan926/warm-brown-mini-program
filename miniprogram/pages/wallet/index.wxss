.wallet-page{padding-bottom:44rpx}.wallet-head{padding:22rpx 0 30rpx;display:flex;flex-direction:column;gap:20rpx}.wallet-head .title{font-size:39rpx;line-height:1.5}.balance-panel{padding:36rpx;background:#60371F;color:#FFF7E8;border-radius:24rpx}.balance-label{font-size:25rpx;color:#E7D8C4}.balance-amount{display:block;font-size:76rpx;font-family:Georgia,serif;letter-spacing:2rpx;margin:24rpx 0 32rpx}.balance-caption{font-size:17rpx;letter-spacing:2rpx}.notice{margin-top:24rpx;line-height:1.9}.login-btn{margin-top:24rpx}.section-heading{padding:38rpx 0 24rpx;display:flex;flex-direction:column;gap:15rpx}.section-title{font-size:32rpx;display:block}.recharge-grid{display:flex;gap:16rpx}.recharge-plan{flex:1;position:relative;display:flex;flex-direction:column;align-items:center;gap:19rpx;border:2rpx solid #E7D8C4;background:#FFFCF6;border-radius:18rpx;padding:30rpx 8rpx}.recharge-plan.chosen{border-color:#60371F;background:#F5EAD7}.plan-amount{font-size:46rpx;font-family:Georgia,serif}.yuan{font-size:25rpx;margin-right:6rpx}.gift{font-size:25rpx;font-weight:500}.plan-received{font-size:20rpx;color:#88684F}.recharge-plan image{position:absolute;top:10rpx;right:10rpx;width:24rpx;height:24rpx}.recharge-btn{width:100%;margin-top:28rpx}.rules{display:flex;flex-direction:column;gap:8rpx;line-height:1.7;font-size:21rpx;color:#88684F;padding-top:20rpx}.transactions{margin-top:38rpx;border-top:1rpx solid #E7D8C4;padding-top:32rpx}.transactions .section-title{margin:14rpx 0 10rpx}.transaction{padding:27rpx 0;border-bottom:1rpx solid #E7D8C4;display:flex;flex-direction:column;gap:13rpx}.transaction-title{font-size:27rpx;flex:1;padding-right:20rpx}.transaction-amount{font-size:30rpx;font-family:Georgia,serif;flex-shrink:0}.transaction .small{font-size:22rpx}
.wallet-page{padding-bottom:calc(44rpx + env(safe-area-inset-bottom))}
