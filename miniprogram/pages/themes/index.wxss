.theme-page{padding-bottom:44rpx}.theme-heading{padding:22rpx 0 32rpx;display:flex;flex-direction:column;gap:18rpx}.theme-heading .title{font-size:37rpx;line-height:1.6}.theme-option{display:flex;border:2rpx solid #E7D8C4;background:#FFFCF6;border-radius:20rpx;overflow:hidden;margin-bottom:26rpx}.selected-theme{border-color:#60371F}.theme-preview{width:240rpx;min-height:354rpx;background:#FAF3E3;padding:20rpx 14rpx 16rpx;display:flex;flex-direction:column;align-items:center;border-right:1rpx solid #E7D8C4;flex-shrink:0;justify-content:center}.preview-hero{width:212rpx;height:175rpx}.mini-welcome{font-size:26rpx;font-weight:600;letter-spacing:3rpx;transform:rotate(-4deg)}.mini-cat-entry{display:flex;width:100%;justify-content:space-around;font-size:17rpx;padding:12rpx 0}.mini-cat-entry text+text{border-left:1rpx solid #CDB496;padding-left:16rpx}.mini-member{width:100%;background:#60371F;color:#FFF7E8;font-size:12rpx;padding:14rpx 10rpx;border-radius:8rpx;display:flex;justify-content:space-between;margin-top:7rpx}.mini-member>text{font-size:19rpx}.theme-description{padding:26rpx 23rpx;display:flex;flex-direction:column;gap:16rpx;flex:1;min-width:0;justify-content:center}.theme-name{font-size:31rpx}.theme-en{font-size:16rpx;letter-spacing:2rpx;line-height:1.7;color:#88684F}.theme-description>.small{font-size:23rpx;line-height:1.9}.theme-state{font-size:23rpx;color:#60371F;margin-top:4rpx}.theme-radio{width:31rpx;height:31rpx;border:1rpx solid #BCA48A;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}.theme-radio>view{width:18rpx;height:18rpx;background:#60371F;border-radius:50%}.cloud-preview .preview-hero{height:146rpx}.mini-brand{font-size:26rpx;font-style:italic;margin-bottom:14rpx}.mini-three{display:flex;gap:5rpx;width:100%;font-size:17rpx}.mini-three text{flex:1;background:#FFFCF6;text-align:center;padding:16rpx 2rpx;border:1rpx solid #E7D8C4;border-radius:5rpx}.mini-vip{display:flex;justify-content:space-between;width:100%;background:#FFFCF6;font-size:16rpx;padding:13rpx 10rpx;margin-top:8rpx;border-radius:5rpx}.mini-vip text+text{background:#E7D8C4;padding:0 15rpx}.mini-two{display:flex;gap:7rpx;width:100%;margin-top:8rpx;font-size:13rpx}.mini-two text{flex:1;background:#FFFCF6;padding:13rpx 3rpx;text-align:center;border-radius:5rpx}.dog-preview .preview-hero{height:130rpx}.mini-dog-brand{font-size:28rpx;font-style:italic;margin-bottom:23rpx}.mini-service{width:100%;background:#FFFCF6;border-radius:7rpx;font-size:16rpx;overflow:hidden;padding-top:11rpx}.mini-service>text:first-child{padding:0 10rpx}.mini-service>view{display:flex;justify-content:space-around;font-size:14rpx;padding:20rpx 0}.mini-store{display:block;background:#60371F;color:#FFF7E8;font-size:12rpx;padding:9rpx}.theme-page>.btn{margin-top:34rpx}.theme-footnote{display:block;text-align:center;font-size:21rpx;color:#88684F;line-height:1.9;padding:22rpx 10rpx 0}
.theme-page{padding-bottom:calc(44rpx + env(safe-area-inset-bottom))}
