<view class="page checkout-page" wx:if="{{!orderId && items.length}}">
  <view class="page-heading"><view class="eyebrow">A LITTLE TREAT, JUST FOR YOU</view><view class="title serif">确认这份温暖</view></view>
  <view class="checkout-fulfillment section"><view class="between"><view class="row"><image class="icon" src="/assets/icons/{{mode}}.png" mode="aspectFit"/><view class="subtitle">{{modeName}}</view></view><button class="pill" bindtap="mode">切换方式 ⌄</button></view>
    <view wx:if="{{mode === 'dineIn'}}" class="field"><text class="label">桌号 · 必填</text><input class="input" value="{{form.tableNumber}}" data-key="tableNumber" bindinput="input" placeholder="例如 A06" maxlength="12"/><text class="small muted">新鲜手作，做好后会送到你的桌边。</text></view>
    <block wx:elif="{{mode === 'pickup'}}"><view class="pickup-fields"><view class="field"><text class="label">取餐人 · 必填</text><input class="input" value="{{form.contact}}" data-key="contact" bindinput="input" placeholder="怎么称呼你" maxlength="20"/></view><view class="field"><text class="label">手机号码 · 必填</text><input class="input" type="number" value="{{form.phone}}" data-key="phone" bindinput="input" placeholder="11位手机号" maxlength="11"/></view></view><picker mode="selector" range="{{pickupTimes}}" bindchange="pickup"><view class="between pickup-time"><text class="muted">取餐时间</text><text>{{form.pickupTime}} ⌄</text></view></picker><button class="store-address" bindtap="store">{{store.name}} · 查看地址 ›</button></block>
    <button wx:else class="address-choice" bindtap="address" hover-class="pressed"><block wx:if="{{address}}"><view class="between"><view class="subtitle">{{address.contact}} <text class="small">{{address.phone}}</text></view><text>›</text></view><view class="address-text">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</view></block><block wx:else><view>添加收货地址 →</view><text class="small muted">请填写完整收件信息</text></block></button>
    <view wx:if="{{mode === 'delivery'}}" class="fulfillment-note">{{store.deliveryRule}}</view><view wx:if="{{mode === 'shipping'}}" class="fulfillment-note">{{store.shippingRule}}</view>
  </view>
  <view class="checkout-products section"><view class="eyebrow">FRESH FROM OUR LITTLE KITCHEN</view><view wx:for="{{items}}" wx:key="id" class="checkout-product"><image src="{{item.image}}" mode="aspectFit"/><view class="checkout-product-copy"><view>{{item.name}}</view><text class="small muted">{{item.specText}}</text><view class="between"><text class="small muted">×{{item.quantity}}</text><text class="serif">¥{{item.priceText}}</text></view></view></view></view>
  <view class="checkout-extras section"><button class="between coupon-row" bindtap="coupons" hover-class="pressed"><view class="row"><image src="/assets/icons/coupon.png" mode="aspectFit"/><text>优惠券</text></view><view class="coupon-label">{{couponName}} ›</view></button><button wx:if="{{couponId}}" class="remove-coupon" bindtap="removeCoupon">不使用优惠券</button><view class="divider"></view><text class="label">给小屋捎句话</text><textarea class="input remark" value="{{form.remark}}" data-key="remark" bindinput="input" placeholder="口味偏好、取餐提醒…（选填）" maxlength="200" show-confirm-bar="false"/><view class="remark-count">{{form.remark.length}} / 200</view></view>
  <view class="checkout-totals section" wx:if="{{quote}}"><view class="money-row"><text class="muted">商品金额</text><text>¥{{subtotalText}}</text></view><view class="money-row"><text class="muted">优惠券</text><text>− ¥{{discountText}}</text></view><view class="money-row"><text class="muted">{{mode === 'shipping' ? '邮寄运费' : '配送费'}}</text><text>{{quote.fee ? '¥' + feeText : '免运费'}}</text></view><view class="divider"></view><view class="between"><text>合计</text><text class="price">¥{{totalText}}</text></view></view>
  <view wx:if="{{error}}" class="notice section">{{error}}</view><view class="checkout-demo">课程演示 · 提交后进入模拟支付，不发生真实扣款</view>
  <view class="fixed-action between"><view><text class="small muted">实付 </text><text class="price">{{quote ? '¥' + totalText : '待确认'}}</text></view><button class="btn submit-btn" disabled="{{busy || !quote}}" loading="{{busy}}" bindtap="submit" hover-class="pressed">提交订单 →</button></view>
</view>
<view class="page empty" wx:else><image src="/assets/illustrations/{{orderId ? 'empty-order' : 'empty-cart'}}.png" mode="aspectFit"/><view class="subtitle">{{orderId ? '订单已经为你留好' : '小袋子还空着'}}</view><text class="muted">{{orderId ? '可以在订单中继续模拟支付。' : '先挑一份今天喜欢的味道吧。'}}</text><button wx:if="{{orderId}}" class="btn" bindtap="viewOrder">查看订单</button><button class="btn-outline" bindtap="menu">继续逛逛菜单</button></view>
