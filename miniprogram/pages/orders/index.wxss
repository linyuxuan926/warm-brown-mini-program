.orders-page{padding-bottom:40rpx}.order-heading{padding:22rpx 8rpx 36rpx;display:flex;flex-direction:column;gap:16rpx}.page-title{font-size:43rpx;line-height:1.4}.filter-scroll{margin:0 -8rpx 28rpx;width:calc(100% + 16rpx);white-space:nowrap}.filters{display:flex;gap:10rpx;padding:4rpx 8rpx}.filter{margin:0;min-width:114rpx;padding:0 22rpx;height:68rpx;line-height:68rpx;font-size:25rpx;color:#88684F;background:transparent;border-radius:50rpx}.filter::after{border:0}.filter.selected{background:#60371F;color:#FFF7E8}.order-list{display:flex;flex-direction:column;gap:24rpx}.order-card{background:#FFFCF6;border:1rpx solid #E7D8C4;border-radius:22rpx;padding:28rpx}.mode-label{font-size:29rpx;font-weight:600}.status{font-size:25rpx;color:#60371F}.status-cancelled{color:#88684F}.order-number{font-size:20rpx;margin-top:13rpx}.product-preview{display:flex;gap:12rpx;padding:26rpx 0;align-items:center}.product-preview image{width:92rpx;height:100rpx;border-radius:12rpx;background:#F5EAD7;flex-shrink:0}.preview-copy{display:flex;flex-direction:column;gap:10rpx;min-width:0;padding-left:6rpx}.summary{font-size:25rpx;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.7}.order-bottom{padding-top:22rpx;border-top:1rpx dashed #E7D8C4;gap:16rpx}.order-actions{display:flex;gap:12rpx;align-items:center}.order-actions button{margin:0;padding:0 22rpx}.empty-art{width:340rpx;height:300rpx}.empty-title{font-size:34rpx}.page-footnote{display:block;text-align:center;font-size:20rpx;letter-spacing:2rpx;color:#88684F;padding:44rpx 0 12rpx}
