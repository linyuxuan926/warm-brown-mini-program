.member-page{padding-bottom:42rpx}.member-heading{display:flex;flex-direction:column;gap:17rpx;padding:20rpx 0 30rpx}.membership-card{background:#60371F;color:#FFF7E8;border-radius:24rpx;padding:34rpx;min-height:230rpx;display:flex;flex-direction:column;justify-content:space-between;box-sizing:border-box}.membership-card image{width:70rpx;height:62rpx}.membership-card .eyebrow{color:#E7D8C4;font-size:18rpx}.card-name{font-size:40rpx;margin:24rpx 0 32rpx}.card-id{font-size:15rpx;letter-spacing:2rpx}.login-callout{display:flex;flex-direction:column;gap:20rpx;margin-top:24rpx}.login-callout button{width:100%}.member-assets{display:flex;padding:38rpx 0;border-bottom:1rpx solid #E7D8C4;gap:12rpx}.member-assets>view{flex:1;text-align:center;display:flex;flex-direction:column;gap:14rpx}.asset-value{font-family:Georgia,serif;font-size:34rpx}.member-assets .small{font-size:21rpx}.benefit-section{padding-top:34rpx}.section-title{font-size:32rpx;display:block;margin:14rpx 0 22rpx}.benefit{display:flex;gap:24rpx;padding:22rpx 0;line-height:1.8}.benefit-index{font-family:Georgia,serif;font-style:italic;font-size:40rpx;color:#88684F;line-height:1.4}.benefit>view{flex:1;display:flex;flex-direction:column;gap:10rpx}.benefit-title{font-size:28rpx;font-weight:500}.record-section{border-top:1rpx solid #E7D8C4;margin-top:14rpx;padding-top:22rpx}.record-row{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid #E7D8C4;font-size:25rpx}.record-row>view{display:flex;flex-direction:column;gap:10rpx}.no-record{padding:20rpx 0}.member-footer{display:flex;flex-direction:column;text-align:center;gap:22rpx;margin-top:35rpx}.member-footer button{width:100%}.member-footer .small{font-size:20rpx}
.member-page{padding-bottom:calc(42rpx + env(safe-area-inset-bottom))}
