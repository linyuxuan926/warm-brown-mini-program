.detail-page{padding-bottom:50rpx}.status-hero{padding:28rpx 6rpx 34rpx;display:flex;flex-direction:column;gap:18rpx}.status-title{font-size:48rpx;line-height:1.35}.status-description{font-size:26rpx;line-height:1.8;max-width:570rpx}.hero-rule{width:96rpx;height:3rpx;background:#60371F;margin-top:12rpx}.section-title{font-size:32rpx;margin:12rpx 0 22rpx}.block{display:block}.pickup-ticket{background:#60371F;color:#FFF7E8;padding:30rpx 34rpx;margin-bottom:28rpx;border-radius:20rpx;display:flex;justify-content:space-between;align-items:center}.pickup-ticket .eyebrow{color:#E7D8C4}.code{font-size:66rpx;letter-spacing:12rpx;display:block;margin-top:12rpx}.ticket-copy{display:flex;flex-direction:column;gap:12rpx;border-left:1rpx dashed #88684F;padding-left:28rpx;font-size:28rpx}.snapshot-row{display:flex;align-items:center;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #E7D8C4}.snapshot-row image{width:110rpx;height:120rpx;flex-shrink:0;background:#F5EAD7;border-radius:12rpx}.snapshot-text{flex:1;min-width:0;display:flex;flex-direction:column;gap:10rpx;line-height:1.5}.product-name{font-size:28rpx;font-weight:500}.product-total{font-size:26rpx;flex-shrink:0}.money-lines{display:flex;flex-direction:column;gap:20rpx;padding-top:28rpx;font-size:25rpx}.total-line{border-top:1rpx dashed #E7D8C4;padding-top:22rpx}.info-row{display:flex;gap:30rpx;justify-content:space-between;font-size:25rpx;line-height:1.7;padding:13rpx 0;word-break:break-all}.info-row>.muted{flex-shrink:0;min-width:115rpx}.info-row>text:last-child{text-align:right}.number-copy{display:flex;gap:16rpx;align-items:center;font-size:23rpx}.address-copy{display:flex;flex-direction:column;text-align:right;gap:8rpx}.timeline{padding-top:4rpx}.timeline-item{position:relative;display:flex;gap:26rpx;padding-bottom:34rpx;line-height:1.7}.timeline-item:not(:last-child)::before{content:'';position:absolute;left:8rpx;top:22rpx;bottom:0;width:1rpx;background:#E7D8C4}.timeline-dot{width:17rpx;height:17rpx;background:#60371F;border-radius:50%;margin-top:11rpx;flex-shrink:0}.timeline-label{font-size:27rpx}.demo-panel{border:1rpx dashed #BCA17D;border-radius:20rpx;padding:28rpx;display:flex;flex-direction:column;gap:13rpx;margin:30rpx 0}.demo-copy{font-size:29rpx}.demo-panel button{width:100%;margin-top:14rpx}.detail-actions{display:flex;gap:20rpx}.detail-actions button{flex:1;margin:0}.final-note{display:block;text-align:center;padding-top:28rpx}.empty-art{width:320rpx;height:300rpx}
.detail-page{padding-bottom:calc(50rpx + env(safe-area-inset-bottom))}
