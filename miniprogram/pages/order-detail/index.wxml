<view class="page detail-page">
  <view wx:if="{{error}}" class="empty"><image class="empty-art" src="/assets/illustrations/empty-order.png" mode="aspectFit"/><text>{{error}}</text><button class="btn" bindtap="toOrders">返回订单</button></view>
  <block wx:elif="{{order}}">
    <view class="status-hero"><text class="eyebrow">A LITTLE MOMENT OF WARMTH</text><text class="serif status-title">{{order.statusText}}</text><text class="muted status-description">{{order.description}}</text><view class="hero-rule"/></view>
    <view wx:if="{{order.mode === 'pickup' && order.status !== 'pending' && order.status !== 'cancelled'}}" class="pickup-ticket"><view><text class="eyebrow">YOUR PICK UP CODE</text><text class="serif code">{{order.pickupCode}}</text></view><view class="ticket-copy"><text>到店取餐码</text><text class="small">请向店员出示</text></view></view>
    <view class="section"><view class="row between"><text class="serif section-title">这次的美味</text><text class="badge">{{order.modeText}}</text></view><view wx:for="{{order.items}}" wx:key="id" class="snapshot-row"><image src="{{item.image}}" mode="aspectFit"/><view class="snapshot-text"><text class="product-name">{{item.name}}</text><text class="small muted">{{item.specText || '标准份'}}</text><text class="small muted">¥{{item.priceText}} × {{item.quantity}}</text></view><text class="product-total">¥{{item.totalText}}</text></view><view class="money-lines"><view class="row between"><text class="muted">商品金额</text><text>¥{{order.subtotalText}}</text></view><view class="row between"><text class="muted">优惠金额</text><text>− ¥{{order.discountText}}</text></view><view class="row between"><text class="muted">{{order.mode === 'shipping' ? '邮寄运费' : '配送费'}}</text><text>¥{{order.feeText}}</text></view><view class="row between total-line"><text>共 {{order.quantity}} 件 · {{order.status === 'pending' || order.status === 'cancelled' ? '应付' : '实付'}}</text><text class="price">¥{{order.totalText}}</text></view></view></view>
    <view class="section"><text class="eyebrow">ORDER DETAILS</text><text class="serif section-title block">订单信息</text><view class="info-row"><text class="muted">订单编号</text><view class="number-copy" bindtap="copyNumber"><text>{{order.number}}</text><text class="link small">复制</text></view></view><view class="info-row"><text class="muted">下单时间</text><text>{{order.dateText}}</text></view><view wx:if="{{order.contact}}" class="info-row"><text class="muted">联系人</text><text>{{order.contact}} · {{order.phone}}</text></view><view wx:if="{{order.mode === 'dineIn'}}" class="info-row"><text class="muted">堂食桌号</text><text>{{order.tableNumber}}</text></view><view wx:if="{{order.mode === 'pickup'}}" class="info-row"><text class="muted">取餐时间</text><text>{{order.pickupTime}}</text></view><view wx:if="{{order.address}}" class="info-row"><text class="muted">收货信息</text><view class="address-copy"><text>{{order.address.contact}} · {{order.address.phone}}</text><text>{{order.address.province}}{{order.address.city}}{{order.address.district}}{{order.address.detail}}</text></view></view><view wx:if="{{order.mode === 'shipping' && (order.status === 'shipped' || order.status === 'completed')}}" class="info-row"><text class="muted">演示运单</text><text>{{order.tracking}}（虚构）</text></view><view class="info-row"><text class="muted">订单备注</text><text>{{order.remark || '无'}}</text></view></view>
    <view class="section timeline-section"><text class="eyebrow">A WARM JOURNEY</text><text class="serif section-title block">订单的每一步</text><view class="timeline"><view wx:for="{{order.timeline}}" wx:key="id" class="timeline-item"><view class="timeline-dot"/><view><text class="timeline-label">{{item.label}}</text><text class="muted small block">{{item.dateText}}</text></view></view></view></view>
    <view wx:if="{{order.nextAction}}" class="demo-panel"><text class="eyebrow">CLASSROOM DEMO</text><text class="demo-copy">演示状态推进</text><text class="muted small">用于答辩展示，无真实制作、配送或物流。</text><button class="btn-outline" bindtap="advance" loading="{{busy}}" disabled="{{busy}}">{{order.nextAction}} →</button></view>
    <view class="detail-actions"><button wx:if="{{order.status === 'pending'}}" class="btn-outline" bindtap="cancel" disabled="{{busy}}">取消订单</button><button wx:if="{{order.status === 'pending'}}" class="btn" bindtap="pay">继续模拟支付</button><button wx:elif="{{order.status === 'completed' || order.status === 'cancelled'}}" class="btn" bindtap="reorder" disabled="{{busy}}">再来一份暖意</button></view><text class="small muted final-note">课程演示订单 · 不产生真实交易</text>
  </block>
</view>
