.store-page{padding-bottom:42rpx}.store-heading{padding:22rpx 0 40rpx;display:flex;flex-direction:column;align-items:center;text-align:center;gap:20rpx}.store-heading image{width:130rpx;height:130rpx;margin-bottom:10rpx}.store-heading .title{font-size:42rpx}.store-heading .eyebrow{font-size:18rpx}.store-intro{padding:32rpx 4rpx;border-top:1rpx solid #CDB496;border-bottom:1rpx solid #CDB496;display:flex;flex-direction:column;gap:18rpx}.store-name{font-size:35rpx}.store-intro>.small{letter-spacing:2rpx;font-size:19rpx}.store-hours{display:flex;align-items:center;gap:12rpx;font-size:26rpx;margin-top:8rpx}.open-dot{width:12rpx;height:12rpx;border-radius:50%;background:#88684F}.store-description{font-size:26rpx;line-height:1.9;color:#88684F}.store-detail{padding:16rpx 4rpx}.store-info-row{display:flex;gap:24rpx;padding:26rpx 0;border-bottom:1rpx solid #E7D8C4}.store-info-row image{width:44rpx;height:46rpx;margin-top:4rpx}.store-info-row>view{flex:1;display:flex;flex-direction:column;gap:14rpx;font-size:27rpx;line-height:1.8}.store-info-row .small{font-size:21rpx}.fulfillment-rules{padding:26rpx 4rpx 12rpx}.section-title{font-size:32rpx;display:block;margin:16rpx 0 26rpx}.rule-row{display:flex;gap:26rpx;padding:16rpx 0 28rpx}.rule-row image{width:80rpx;height:82rpx}.rule-row>view{display:flex;flex-direction:column;gap:12rpx;flex:1;font-size:28rpx}.rule-row .small{line-height:1.9}.store-actions{display:flex;flex-direction:column;gap:18rpx;margin-top:14rpx}.store-actions button{width:100%}.fictional-note{margin-top:28rpx;font-size:22rpx}
.store-page{padding-bottom:calc(42rpx + env(safe-area-inset-bottom))}
