@import "styles/tokens.wxss";
@import "styles/paper.wxss";
page { background-color: #FAF3E3; color: #3F2A1F; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; line-height: 1.55; }
view, text, button, input, textarea, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0; border-radius: 0; font-weight: normal; font-size: 28rpx; line-height: 1.5; color: inherit; background: transparent; }
button::after { border: 0; }
button[disabled] { color: #9B8571; background: #E9DFD0; }
image { display: block; height: auto; flex-shrink: 0; }
.page { padding: 30rpx 34rpx 56rpx; padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.section { margin-bottom: 28rpx; }
.card { background: #FFFCF6; border: 1rpx solid #E7D8C4; padding: 30rpx; border-radius: 22rpx; }
.row { display: flex; align-items: center; gap: 16rpx; }
.between { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.muted { color: #88684F; }
.small { font-size: 23rpx; }
.eyebrow { font-size: 20rpx; font-weight: 500; letter-spacing: 4rpx; color: #88684F; }
.serif { font-family: Georgia, "Songti SC", SimSun, serif; }
.title { font-size: 42rpx; font-weight: 600; letter-spacing: 2rpx; }
.subtitle { font-size: 31rpx; font-weight: 600; }
.price { font-family: Georgia, serif; font-size: 36rpx; font-weight: 600; font-variant-numeric: tabular-nums; color: #60371F; }
.btn { display: flex; align-items: center; justify-content: center; min-height: 92rpx; border: 1rpx solid #60371F; border-radius: 16rpx; background: #60371F; color: #FFF7E8; font-size: 28rpx; font-weight: 500; padding: 20rpx 32rpx; text-align: center; }
.btn-outline { display: flex; align-items: center; justify-content: center; min-height: 88rpx; border: 1rpx solid #BCA48A; border-radius: 16rpx; color: #60371F; background: transparent; padding: 18rpx 28rpx; text-align: center; }
.btn-small { min-height: 66rpx; padding: 12rpx 24rpx; font-size: 24rpx; border-radius: 12rpx; }
.btn, .btn-outline, .press { transition: transform 140ms cubic-bezier(.23,1,.32,1), opacity 140ms ease-out; }
.pressed { transform: scale(.975); opacity: .85; }
.link { color: #60371F; text-decoration: underline; text-underline-offset: 6rpx; }
.divider { height: 1rpx; background: #E7D8C4; margin: 24rpx 0; }
.empty { padding: 60rpx 16rpx; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20rpx; }
.empty image { width: 230rpx; height: 190rpx; }
.field { margin: 24rpx 0; }
.label { font-size: 24rpx; color: #88684F; display: block; margin-bottom: 12rpx; }
.input { width: 100%; min-height: 84rpx; padding: 18rpx 22rpx; background: #FAF3E3; border: 1rpx solid #E7D8C4; border-radius: 12rpx; font-size: 28rpx; }
.badge { display: inline-flex; align-items: center; padding: 4rpx 13rpx; font-size: 21rpx; border: 1rpx solid #D8C6AB; border-radius: 7rpx; color: #775137; background: #F5EAD7; }
.list-row { display: flex; align-items: center; justify-content: space-between; padding: 27rpx 0; gap: 20rpx; border-bottom: 1rpx solid #E7D8C4; }
.list-row:last-child { border-bottom: 0; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.stack > view, .stack > button { margin-bottom: 20rpx; }
.notice { font-size: 24rpx; color: #775137; background: #F1E4CE; border-radius: 12rpx; padding: 20rpx 24rpx; line-height: 1.7; }
.icon { width: 48rpx; height: 48rpx; }
.arrow { width: 28rpx; height: 28rpx; }
.page-heading { padding: 14rpx 0 32rpx; }
.page-heading .eyebrow { margin-top: 8rpx; }
.footer-note { text-align: center; font-size: 21rpx; color: #88684F; letter-spacing: 2rpx; margin-top: 36rpx; }
.pill { padding: 9rpx 20rpx; background: #F5EAD7; border-radius: 100rpx; border: 1rpx solid #DCC8AE; font-size: 23rpx; }
.sheet-mask { position: fixed; inset: 0; background: rgba(42,27,18,.38); z-index: 100; display: flex; align-items: flex-end; }
.sheet { width: 100%; max-height: 88vh; background: #FFFCF6; border-radius: 32rpx 32rpx 0 0; padding: 30rpx 34rpx; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); }
.sheet-scroll { height: 52vh; max-height: 63vh; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.close-button { min-width: 76rpx; min-height: 76rpx; display: flex; align-items: center; justify-content: center; }
.close-button image { width: 32rpx; height: 32rpx; }
.money-row { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 0; font-size: 26rpx; }
.fixed-action { position: fixed; bottom: 0; left: 0; right: 0; border-top: 1rpx solid #E7D8C4; background: #FFFCF6; padding: 22rpx 34rpx; padding-bottom: calc(22rpx + env(safe-area-inset-bottom)); z-index: 10; }
@media (prefers-reduced-motion: reduce) { .btn, .btn-outline, .press { transition: none; } .pressed { transform: none; } }
